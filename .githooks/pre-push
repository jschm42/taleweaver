#!/bin/sh
# TaleWeaver Git Pre-Push Hook (opt-in)
# Runs the tests the pushed commits can affect (scripts/run_tests.py pre-push), but only
# with TW_PRE_PUSH_TESTS=1. The required gate is CI on the pull request (docs/testing.md).

if [ "$TW_PRE_PUSH_TESTS" != "1" ]; then
    exit 0
fi

echo "🧪 TaleWeaver pre-push: running the affected tests..."

if command -v poetry >/dev/null 2>&1; then
    poetry run python scripts/run_tests.py pre-push
    EXIT_CODE=$?
elif [ -f "./venv/Scripts/python.exe" ]; then
    ./venv/Scripts/python.exe scripts/run_tests.py pre-push
    EXIT_CODE=$?
elif [ -f "./venv/bin/python" ]; then
    ./venv/bin/python scripts/run_tests.py pre-push
    EXIT_CODE=$?
else
    echo "⚠️ Poetry/venv not found. Skipping test hook."
    exit 0
fi

if [ $EXIT_CODE -ne 0 ]; then
    echo "❌ Pre-push hook aborted the push: tests failed."
    echo "💡 Rerun with 'poetry run python scripts/run_tests.py affected', or skip once with 'git push --no-verify'."
    exit $EXIT_CODE
fi

exit 0
